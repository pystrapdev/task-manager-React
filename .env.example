DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
# Set true when your provider requires TLS. Certificates are always verified.
DB_SSL=false
# Optional provider CA certificate path (server only):
# DB_SSL_CA_FILE=/path/to/ca.pem
# Hosting platforms usually supply PORT automatically.
PORT=3000
HOST=0.0.0.0
